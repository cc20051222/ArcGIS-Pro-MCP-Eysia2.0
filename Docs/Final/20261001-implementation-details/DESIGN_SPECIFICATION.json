  "invariants": [
    {
      "id": "INV01",
      "name": "intent-failure-zero-dispatch",
      "rule": "Durable intent failure blocks host dispatch."
    },
    {
      "id": "INV02",
      "name": "receipt-failure-no-blind-retry",
      "rule": "Effect success with receipt failure enters RECORD_PENDING and reconciliation; host execution is not repeated."
    },
    {
      "id": "INV03",
      "name": "unknown-not-pending",
      "rule": "Unknown or partial effects cannot become ordinary pending for automatic dispatch."
    },
    {
      "id": "INV04",
      "name": "cancel-is-request-not-outcome",
      "rule": "A cancellation request does not prove no side effect."
    },
    {
      "id": "INV05",
      "name": "fence-check-not-rollback",
      "rule": "Stale owner cannot record or activate; late effects still require isolation and reconciliation."
    },
    {
      "id": "INV06",
      "name": "one-invocation-boundary",
      "rule": "MCP, workbench, recipes, repair and all GP modes share preparation and invocation."
    },
    {
      "id": "INV07",
      "name": "input-consistency-required",
      "rule": "Input and dependency revisions must satisfy the required isolation level before reuse or delivery."
    },
    {
      "id": "INV08",
      "name": "null-is-not-zero",
      "rule": "Missing/unknown facts retain nullReason and cannot be silently converted to zero."
    },
    {
      "id": "INV09",
      "name": "claim-bindings-same-revision",
      "rule": "All necessary artifacts reference one validated fact revision and denominator policy."
    },
    {
      "id": "INV10",
      "name": "ps-global-single-writer",
      "rule": "Photoshop modal writes are serialized across the host, with owned document identity."
    },
    {
      "id": "INV11",
      "name": "all-required-before-activation",
      "rule": "Delivery activation requires all necessary artifact/state/science checks and a current fence."
    },
    {
      "id": "INV12",
      "name": "budget-survives-restart",
      "rule": "Revisions, models, experiments and retries share the root budget; restart does not reset it."
    },
    {
      "id": "INV13",
      "name": "no-capability-count-inflation",
      "rule": "Aliases, interfaces, examples and work items do not increase canonical operation counts."
    },
    {
      "id": "INV14",
      "name": "no-arbitrary-code",
      "rule": "Model proposals and codecs cannot introduce arbitrary Python/JS or transport bypasses."
    },
    {
      "id": "INV15",
      "name": "final-installer-last",
      "rule": "The final unified installer is built only after this roadmap's functional, quantity, quality and experience gates."
    },
    {
      "id": "INV16",
      "name": "legacy-ambiguity-reconcile",
      "rule": "Legacy pending/corrupt/torn records never alone prove not-executed; preserve old carriers and resolve ambiguous effects."
    }
